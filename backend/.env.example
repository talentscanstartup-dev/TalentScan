# ===== SUPABASE CONFIGURATION =====
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===== JWT CONFIGURATION =====
JWT_SECRET=sua-chave-super-secreta-minimo-32-caracteres-aleatorios
JWT_EXPIRY=7d

# ===== EMAIL CONFIGURATION =====
# Gmail SMTP (usar com app-specific password)
EMAIL_SERVICE=gmail
EMAIL_USER=seu-email@gmail.com
EMAIL_PASSWORD=sua-senha-app-google

# Alternativa: SendGrid
# EMAIL_SERVICE=sendgrid
# EMAIL_API_KEY=SG.seu-api-key

# Alternativa: AWS SES
# EMAIL_SERVICE=ses
# AWS_ACCESS_KEY_ID=sua-chave
# AWS_SECRET_ACCESS_KEY=sua-secreta
# AWS_REGION=us-east-1

# ===== APPLICATION URLS =====
FRONTEND_URL=http://localhost:3000
ADMIN_DASHBOARD_URL=http://localhost:3000/admin
BACKEND_URL=http://localhost:5000

# ===== SERVER CONFIGURATION =====
PORT=5000
NODE_ENV=development

# ===== SECURITY =====
# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5

# CORS
CORS_ORIGIN=http://localhost:3000

# ===== LOGGING =====
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# ===== DATABASE =====
# Supabase já fornece, mas pode customizar aqui
DATABASE_TIMEOUT=5000
DATABASE_POOL_SIZE=10

# ===== FEATURES FLAGS =====
ENABLE_EMAIL_VERIFICATION=true
ENABLE_TWO_FACTOR_AUTH=false
ENABLE_SOCIAL_LOGIN=false

# ===== THIRD PARTY INTEGRATIONS =====
# N8N (se usar)
N8N_BASE_URL=https://seu-n8n.com

# Google Sheets (futuro)
GOOGLE_SHEETS_API_KEY=sua-chave

# Telegram Bot (futuro)
TELEGRAM_BOT_TOKEN=seu-token

# ===== MONITORING =====
SENTRY_DSN=https://chave@seu-projeto.ingest.sentry.io/123456
ENABLE_MONITORING=false
