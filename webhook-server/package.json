{
  "name": "talent-scan-webhook-server",
  "version": "1.0.0",
  "description": "Webhook server para receber dados de curriculos do n8n",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "curl -X GET http://localhost:3001/health",
    "tunnel": "npx localtunnel --port 3001",
    "tunnel:ngrok": "ngrok http 3001"
  },
  "keywords": [
    "webhook",
    "n8n",
    "curriculo",
    "express",
    "nodejs"
  ],
  "author": "Talent Scan",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.107.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "pdf-parse": "^1.1.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
