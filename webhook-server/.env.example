# ===== WEBHOOK SERVER CONFIGURATION =====

# Porta do servidor
PORT=3001

# Ambiente
NODE_ENV=development

# ===== N8N WEBHOOK TOKEN =====
# Token Bearer que o n8n deve enviar no header Authorization
# Gere um token seguro: openssl rand -hex 32
N8N_WEBHOOK_TOKEN=seu-token-super-secreto-32-caracteres-aleatorios

# ===== CORS CONFIGURATION =====
# URLs permitidas (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://seu-dominio.com

# ===== SUPABASE (quando integrar banco de dados) =====
# VITE_SUPABASE_URL=https://seu-projeto.supabase.co
# VITE_SUPABASE_ANON_KEY=sua-chave-anonima
# SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# ===== LOGGING =====
LOG_LEVEL=debug
LOG_FILE=logs/webhook.log

# ===== N8N SERVER (informação para referência) =====
# N8N_URL=https://seu-n8n.com
# N8N_API_KEY=sua-chave-api-n8n

# ===== GROQ API (usado pela automação n8n para extrair dados) =====
# GROQ_API_KEY=sua-chave-groq

# ===== NOTIFICACOES (futuro) =====
# EMAIL_SERVICE=smtp
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=seu-email@gmail.com
# EMAIL_PASSWORD=sua-senha-app
